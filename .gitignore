# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Assinatura Android (NUNCA versionar: perder a keystore = nao conseguir atualizar o app)
# O key.properties.example continua versionado de proposito: e o modelo, sem senhas.
**/key.properties
**/*.jks
**/*.keystore

# Assinatura e API da Apple
**/*.p12
**/*.p8
**/*.cer
**/*.certSigningRequest
**/*.mobileprovision

# Credenciais de servicos (nenhum em uso hoje; a regra e preventiva)
**/google-services.json
**/GoogleService-Info.plist

# Vercel
.vercel
.env*

# Binarios de release, caso saiam de /build/
*.aab
*.apk
*.ipa
